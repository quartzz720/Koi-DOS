# Build output
boot/efi/boot/BOOTX64.EFI
boot/efi/boot/KERNEL.ELF
boot/efi/boot/KERNEL.BIN
boot/efi/boot/*.efi
kernel/kernel.elf
kernel/build.h
build/
sdk/*.EXE
*.o
*.obj
*.a
*.so
*.dll

# Disk images and firmware variable stores
*.img
*.fd

# Working notes, kept out of the repo on purpose
PLAN.md

# Editor and OS leftovers
*.save
*.swp
*.swo
*.kate-swp
*.tmp
*.bak
*~
.*.swp
.DS_Store
Thumbs.db

# IDE and tool settings
.vscode/*
# ...except the include paths, so an editor resolves what the compiler does.
# Only this one file: settings.json and launch.json routinely accumulate local
# paths and tokens, and those stay out.
!.vscode/c_cpp_properties.json
.idea/
*.code-workspace
.claude/settings.local.json

# Logs pulled off a machine with `log <file>`. Useful to look at, never worth
# committing - they are one boot of one machine.
*.log

# Host-side bench helper, not part of the system
lan.sh
koi.log
