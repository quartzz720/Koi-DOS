# =====================================================================
# ADDITIONAL PERMISSIONS - any number, layered on the base
# =====================================================================

  [REDISTRIBUTABLE-SDK]
      Section 1.9 material. May be compiled into, linked into, and
      distributed as part of a Program for Koi-DOS, under that program's
      own license, including a commercial one.

  [INTERFACE-ONLY]
      Section 1.8 material. Describes an interface rather than an
      implementation of one. Reimplementing an interface listed here does
      not make the result a derivative work of Koi-DOS.


[REDISTRIBUTABLE-SDK]

# Everything koicc compiles into a program, and nothing else.
#
# koicc builds a program from the author's source PLUS start.c and
# koilib.c, so that code is inside every .EXE ever built for Koi-DOS. If
# it were not redistributable, no third party could ship a program at
# all - and the three that already exist outside this repository would
# each be a violation. Section 6 promises that programs are their
# authors' own; these entries are what make the promise true.
#
# Listed file by file rather than as `sdk/`, because koicc and the SDK's
# README are tools and documentation. They are KNCL like everything else
# and do not go inside anybody's program.
#
# programs/ holds the originals; `make` copies them into sdk/. The two
# copies are the same files and carry the same permission.

include/syscall.h
programs/koi.h
programs/koilib.c
programs/start.c
programs/program.ld
sdk/syscall.h
sdk/koi.h
sdk/koilib.c
sdk/start.c
sdk/program.ld


[INTERFACE-ONLY]

# The system call ABI. Also redistributable above, and that is two
# different permissions rather than a contradiction:
#
#   REDISTRIBUTABLE-SDK - you may ship this file inside your program;
#   INTERFACE-ONLY      - you may write your own implementation of this
#                         interface, and the result is not a derivative
#                         work of Koi-DOS.
#
# The second is what makes an independent Koi-DOS-compatible system
# possible. Nothing here obliges anyone to use this kernel to honour this
# ABI.

include/syscall.h
sdk/syscall.h
